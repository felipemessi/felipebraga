{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/blog/).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 2048
              }
            ],
            "resource-summary:document:size": [
              "error",
              {
                "maxNumericValue": 12288
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 14336
              }
            ],
            "resource-summary:font:size": [
              "error",
              {
                "maxNumericValue": 126976
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/blog/",
