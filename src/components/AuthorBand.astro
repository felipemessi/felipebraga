---
import { Image } from 'astro:assets';
import avatar from '../assets/felipe-avatar.jpg';
import { LINKS } from '../lib/links';
import { SITE } from '../lib/site';
---

<section data-tone="salvia" class="author">
  <div class="container band">
    <div class="inner">
      <Image src={avatar} alt="" width={72} height={72} class="photo" />
      <div>
        <p class="name">{SITE.name}</p>
        <p class="tagline">{SITE.tagline}</p>
        <nav aria-label="Sobre o autor">
          <a href={LINKS.rss}>RSS</a>
          <a href={LINKS.linkedin}>LinkedIn</a>
        </nav>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: 40px;
  }

  .inner {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    max-width: 720px;
  }

  .photo {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: var(--radius-pill);
    object-fit: cover;
    border: 1px solid rgba(31, 35, 40, 0.18);
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .tagline {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  nav {
    display: flex;
    gap: 20px;
    margin-top: var(--space-2);
    font-size: var(--text-small);
    font-weight: 600;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
  }

  @media (min-width: 768px) {
    .band {
      padding-block: 80px;
    }

    .inner {
      gap: var(--space-6);
      align-items: center;
    }

    .photo {
      width: 72px;
      height: 72px;
    }

    .name {
      font-size: 1.5rem;
    }

    .tagline {
      margin-bottom: var(--space-2);
      font-size: 1.0625rem;
    }

    nav {
      margin-top: 0;
    }
  }

  @media (min-width: 1024px) {
    .inner {
      margin-left: 320px;
    }
  }
</style>
