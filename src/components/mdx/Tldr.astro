---
---

<div class="tldr">
  <p class="label">TL;DR</p>
  <slot />
</div>

<style>
  .tldr {
    margin-bottom: var(--space-8);
    padding: 18px 20px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--post-bg);
  }

  .label {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .tldr :global(ul) {
    margin: 0;
    padding-left: 18px;
    font-size: 1rem;
    line-height: 1.55;
  }

  .tldr :global(li) {
    margin: 0;
  }

  @media (min-width: 768px) {
    .tldr {
      margin-bottom: var(--space-12);
      padding: 24px 28px;
    }

    .label {
      margin-bottom: var(--space-2);
      text-transform: uppercase;
    }

    .tldr :global(ul) {
      padding-left: 20px;
      font-size: 1.0625rem;
    }
  }
</style>
