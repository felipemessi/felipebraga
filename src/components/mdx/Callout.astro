---
import { calloutSpec, type CalloutType } from '../../lib/mdx/callout';

interface Props {
  type: CalloutType;
}

const { type } = Astro.props;
const { tone, label } = calloutSpec(type);
---

<div role="note" data-tone={tone} class="callout">
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    {type === 'nota' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 8h.01M11 12h1v5h1" />
      </>
    )}
    {type === 'dica' && (
      <>
        <path d="M9 18h6M10 21h4" />
        <path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z" />
      </>
    )}
    {type === 'atencao' && (
      <>
        <path d="M12 3 2 20h20L12 3Z" />
        <path d="M12 10v4M12 17h.01" />
      </>
    )}
    {type === 'perigo' && (
      <>
        <path d="M8 3h8l5 5v8l-5 5H8l-5-5V8l5-5Z" />
        <path d="M12 8v5M12 16h.01" />
      </>
    )}
  </svg>
  <div class="text">
    <strong>{label}</strong> <slot />
  </div>
</div>

<style>
  .callout {
    display: flex;
    gap: var(--space-3);
    margin: var(--space-6) 0;
    padding: 16px 18px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
  }

  svg {
    flex: none;
    margin-top: 3px;
    color: var(--accent);
  }

  .text {
    min-width: 0;
    font-size: 1rem;
    line-height: 1.55;
  }

  .text :global(p) {
    display: inline;
    margin: 0;
  }

  strong {
    color: var(--accent);
  }

  @media (min-width: 768px) {
    .callout {
      gap: var(--space-4);
      margin: var(--space-8) 0;
      padding: 20px 24px;
    }

    .text {
      font-size: 1.0625rem;
      line-height: 1.6;
    }
  }
</style>
