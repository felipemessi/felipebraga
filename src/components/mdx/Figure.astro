---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { assertAlt, findPostImage, slugFromPath } from '../../lib/mdx/figure';

interface Props {
  /** Image imported in the MDX, or a path relative to the post (`./a.png`). */
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  /** Extends into the right margin on wide screens, full-bleed on mobile. */
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;

const images = {
  ...import.meta.glob<{ default: ImageMetadata }>(
    '/src/content/posts/**/*.{png,jpg,jpeg,webp,avif,gif}',
  ),
  ...import.meta.glob<{ default: ImageMetadata }>(
    '/tests/fixtures/content/posts/**/*.{png,jpg,jpeg,webp,avif,gif}',
  ),
};

const name = typeof src === 'string' ? src : 'image';
assertAlt(alt, name);

let image: ImageMetadata;
if (typeof src === 'string') {
  const slug = slugFromPath(Astro.url.pathname);
  if (slug === undefined) {
    throw new Error(`<Figure src="${src}"> can only be used in a post`);
  }
  const key = findPostImage(Object.keys(images), slug, src);
  const load = images[key];
  if (load === undefined) throw new Error(`<Figure src="${src}">: not found`);
  image = (await load()).default;
} else {
  image = src;
}
---

<figure class:list={['figure', { wide }]}>
  <Picture
    src={image}
    {alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    widths={[400, 800, 1200, 1600]}
    sizes={
      wide
        ? '(min-width: 1200px) 880px, 100vw'
        : '(min-width: 768px) 720px, 100vw'
    }
    loading="lazy"
    decoding="async"
  />
  {caption !== undefined && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: var(--space-6) 0 var(--space-8);
  }

  .figure :global(img) {
    width: 100%;
    height: auto;
    border: var(--border);
    border-radius: var(--radius-lg);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Full-bleed on phones. */
  @media (max-width: 767px) {
    .wide {
      margin-inline: -20px;
    }

    .wide :global(img) {
      border-radius: 0;
      border-inline: 0;
    }

    .wide figcaption {
      margin-inline: 20px;
    }
  }

  @media (min-width: 768px) {
    .figure {
      margin: var(--space-8) 0 40px;
    }
  }

  @media (min-width: 1200px) {
    /* Up to 160px into the right margin, never past the viewport: the margin
       is what is left beside the 1200px container, minus a classic scrollbar. */
    .wide {
      margin-right: calc(-1 * min(160px, (100vw - 1200px) / 2 + 48px - 15px));
    }
  }
</style>
