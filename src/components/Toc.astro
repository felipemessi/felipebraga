---
import { toneVars, type Tone } from '../lib/tone';
import type { TocEntry } from '../lib/post/toc';

interface Props {
  toc: TocEntry[];
  tone: Tone;
  /** `aside` is the sticky desktop column; `bar` is the mobile `<details>`. */
  variant: 'aside' | 'bar';
}

const { toc, tone, variant } = Astro.props;
---

{variant === 'aside' ? (
  <aside class="aside" style={toneVars(tone)}>
    <p class="label">Nesta página</p>
    <nav aria-label="Índice">
      <ol>
        {toc.map((entry) => (
          <li>
            <a href={`#${entry.slug}`}>{entry.text}</a>
            {entry.children.length > 0 && (
              <ol>
                {entry.children.map((child) => (
                  <li class="child">
                    <a href={`#${child.slug}`}>{child.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
    <div class="progress" aria-hidden="true">
      <div class="fill"></div>
    </div>
  </aside>
) : (
  <div class="bar" style={toneVars(tone)}>
    <div class="container">
      <details>
        <summary>
          <span>Índice</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <nav aria-label="Índice">
          <ol>
            {toc.map((entry) => (
              <li>
                <a href={`#${entry.slug}`}>{entry.text}</a>
                {entry.children.length > 0 && (
                  <ol>
                    {entry.children.map((child) => (
                      <li class="child">
                        <a href={`#${child.slug}`}>{child.text}</a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </nav>
      </details>
    </div>
    <div class="progress" aria-hidden="true">
      <div class="fill"></div>
    </div>
  </div>
)}

<style>
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .progress {
    height: 2px;
    background: rgba(31, 35, 40, 0.1);
  }

  .fill {
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  @supports (animation-timeline: scroll(root)) {
    .fill {
      /* Longhands on purpose: the minifier would merge a complete set into an
         `animation` shorthand with scroll(root), which browsers reject. */
      animation-name: read;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes read {
    to {
      transform: scaleX(1);
    }
  }

  /* Mobile and tablet: sticky bar with <details>. */
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--bg-creme);
    border-bottom: var(--border);
  }

  .bar .progress {
    border-bottom: 0;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    font-size: var(--text-small);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-creme);
  }

  details[open] svg {
    transform: rotate(180deg);
  }

  .bar nav {
    max-height: 60vh;
    overflow-y: auto;
    padding-bottom: var(--space-3);
  }

  .bar a {
    padding: 12px 0;
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .bar .child a {
    padding-left: var(--space-4);
    font-size: 0.875rem;
  }

  .aside {
    display: none;
  }

  /* Desktop: sticky column. */
  @media (min-width: 1024px) {
    .bar {
      display: none;
    }

    .aside {
      display: block;
      width: 240px;
      flex: none;
      position: sticky;
      top: var(--space-8);
    }

    .label {
      margin-bottom: var(--space-4);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--accent-creme);
    }

    .aside nav {
      border-left: 1px solid rgba(31, 35, 40, 0.16);
      font-size: var(--text-small);
      line-height: 1.4;
    }

    .aside a {
      padding: 8px 0 8px 16px;
    }

    .aside .child a {
      padding: 6px 0 6px 32px;
      font-size: 0.875rem;
    }

    .aside .progress {
      margin-top: var(--space-8);
      border-radius: 2px;
    }
  }
</style>
