---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import Band from '../components/Band.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import type { ArticleInput } from '../lib/seo';
import { SITE } from '../lib/site';
import { DEFAULT_TONE, type Tone } from '../lib/tone';

interface Props {
  title?: string;
  description?: string;
  tone?: Tone;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: string;
  article?: ArticleInput;
}

const {
  title,
  description,
  tone = DEFAULT_TONE,
  canonical,
  image,
  type,
  noindex,
  jsonLd,
  article,
} = Astro.props;
const path = Astro.url.pathname;
---

<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      {title}
      {description}
      {path}
      {canonical}
      {image}
      {type}
      {noindex}
      {jsonLd}
      {article}
    />
    <Font
      cssVariable="--font-fraunces"
      preload={[{ subset: 'latin', style: 'normal' }]}
    />
    <Font
      cssVariable="--font-instrument-sans"
      preload={[{ subset: 'latin', style: 'normal' }]}
    />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <Header {tone} />
    <main id="conteudo">
      {Astro.slots.has('hero') && (
        <Band {tone}>
          <slot name="hero" />
        </Band>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>
