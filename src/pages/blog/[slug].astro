---
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, ImageMetadata } from 'astro';
import avatar from '../../assets/felipe-avatar.jpg';
import Post from '../../layouts/Post.astro';
import { hasCodeBlock } from '../../lib/copy-code';
import { filterPublished } from '../../lib/content/visibility';
import { toPostView } from '../../lib/post/view';

export const getStaticPaths = (async () => {
  const now = new Date();
  const posts = filterPublished(await getCollection('posts'), now);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const tags = await getCollection('tags');
const site = Astro.site?.origin ?? 'http://localhost:4321';

// The schema types `image()` as unknown; it is ImageMetadata at runtime.
const cover = entry.data.cover as ImageMetadata | undefined;
const coverImage =
  cover === undefined
    ? undefined
    : await getImage({ src: cover, format: 'jpeg', width: 1200 });

const view = toPostView({
  slug: entry.id,
  data: entry.data,
  body: entry.body ?? '',
  tagNames: new Map(tags.map((tag) => [tag.id, tag.data.name])),
  site,
  coverSrc: coverImage?.src,
  authorImage: avatar.src,
});
---

<Post
  {view}
  title={entry.data.title}
  description={entry.data.description}
  cover={cover}
  coverAlt={entry.data.coverAlt}
  publishedTime={entry.data.publishDate}
  {Content}
  hasCode={hasCodeBlock(entry.body ?? '')}
  {headings}
/>
